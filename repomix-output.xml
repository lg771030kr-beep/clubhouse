                  자료 / 양식 열기
                </Button>
              ) : null}
              <Button type="button" variant="outline" className="w-full" onClick={() => setSelected(null)}>
                닫기
              </Button>
            </CardContent>
          </Card>
        </div>
      )}
    </div>
  );
};
