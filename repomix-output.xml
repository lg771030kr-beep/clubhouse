<file path="src/pages/admin/Schedules.tsx">
import React, { useState, useEffect } from 'react';
import { supabase } from '../../lib/supabase';
import { AttendanceQR } from './AttendanceQR';
import { 
  Calendar as CalendarIcon, 
  Plus, 
  Trash2, 
  QrCode, 
  ChevronLeft, 
  ChevronRight,
  Clock,
  MapPin,
  FileText,
  X,
  BookOpen,
  UploadCloud,
  Loader2,
  File as FileIcon
} from 'lucide-react';
import { motion, AnimatePresence } from 'motion/react';
interface Schedule {
  id: string;
  title: string;
  type: 'GENERAL' | 'ASSIGNMENT';
  date: string;
  time: string;
  location: string;
  description: string;
  assignment_template_url?: string;
  is_approved?: boolean;
  created_at: string;
}

export function Schedules() {
  const [schedules, setSchedules] = useState<Schedule[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [currentDate, setCurrentDate] = useState(new Date());
  
  // Modals
  const [isAdding, setIsAdding] = useState(false);
  const [selectedQR, setSelectedQR] = useState<string | null>(null);
  
  // Form state
  const [newSchedule, setNewSchedule] = useState({
    title: '',
    type: 'GENERAL' as 'GENERAL' | 'ASSIGNMENT',
    date: '',
    time: '',
    location: '',
    description: ''
  });

  const [file, setFile] = useState<File | null>(null);
  const [isDragOver, setIsDragOver] = useState(false);
  const [isUploading, setIsUploading] = useState(false);

  useEffect(() => {
    fetchSchedules();
  }, []);

  const fetchSchedules = async () => {
    try {
      setIsLoading(true);
      const { data, error } = await supabase
        .from('schedules')
        .select('*')
        .order('date', { ascending: true })
        .order('time', { ascending: true });
        
      if (error) throw error;
      setSchedules(data || []);
    } catch (error) {
      console.error('Error fetching schedules:', error);
      alert('일정을 불러오는데 실패했습니다.');
    } finally {
      setIsLoading(false);
    }
  };

  const handleAddSchedule = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      setIsUploading(true);
      
      let assignment_template_url = null;

      // Handle File Upload if assignment
      if (newSchedule.type === 'ASSIGNMENT' && file) {
        const fileExt = file.name.split('.').pop();
        const fileName = `template-${Date.now()}-${Math.random().toString(36).substring(2)}.${fileExt}`;
        
        const { error: uploadError } = await supabase.storage
          .from('assignments')
          .upload(fileName, file);

        if (uploadError) {
          throw new Error(`File upload failed: ${uploadError.message}`);
        }

        const { data: publicUrlData } = supabase.storage
          .from('assignments')
          .getPublicUrl(fileName);
          
        assignment_template_url = publicUrlData.publicUrl;
      }

      // ADMIN explicitly approves, LEADER defaults to unapproved (false)
      // 관리자 일정 화면에서 생성하는 항목은 즉시 승인
      const isApproved = true;

      const { data, error } = await supabase
        .from('schedules')
        .insert([{
          title: newSchedule.title,
          type: newSchedule.type,
          date: newSchedule.date,
          time: newSchedule.time,
          location: newSchedule.location,
          description: newSchedule.description,
          assignment_template_url,
          is_approved: isApproved
        }])
        .select()
        .single();
        
      if (error) throw error;
      
      const newSchedules = [...schedules, data].sort((a, b) => {
        if (a.date === b.date) return a.time.localeCompare(b.time);
        return a.date.localeCompare(b.date);
      });
      
      setSchedules(newSchedules);
      setIsAdding(false);
      setNewSchedule({
        title: '',
        type: 'GENERAL',
        date: '',
        time: '',
        location: '',
        description: ''
      });
      setFile(null);
    } catch (error: any) {
      console.error('Error adding schedule:', error);
      alert(`일정 등록에 실패했습니다. ${error.message || ''}`);
    } finally {
      setIsUploading(false);
    }
  };

  const handleDelete = async (id: string) => {
    if (!window.confirm('정말로 이 일정을 삭제하시겠습니까?')) return;
    
    try {
      const { error } = await supabase
        .from('schedules')
        .delete()
        .eq('id', id);
        
      if (error) throw error;
      
      setSchedules(schedules.filter(s => s.id !== id));
    } catch (error) {
      console.error('Error deleting schedule:', error);
      alert('일정 삭제에 실패했습니다.');
    }
  };

  // Calendar Logic
  const getDaysInMonth = (year: number, month: number) => new Date(year, month + 1, 0).getDate();
  const getFirstDayOfMonth = (year: number, month: number) => new Date(year, month, 1).getDay();
  
  const year = currentDate.getFullYear();
  const month = currentDate.getMonth();
  const daysInMonth = getDaysInMonth(year, month);
  const firstDay = getFirstDayOfMonth(year, month);
  
  const handlePrevMonth = () => setCurrentDate(new Date(year, month - 1));
  const handleNextMonth = () => setCurrentDate(new Date(year, month + 1));
  
  const formatDateString = (y: number, m: number, d: number) => {
    return `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  };

  const monthNames = ["1월", "2월", "3월", "4월", "5월", "6월", "7월", "8월", "9월", "10월", "11월", "12월"];
  const weekDays = ["일", "월", "화", "수", "목", "금", "토"];

  return (
    <div className="space-y-8 pb-12 max-w-5xl mx-auto">
      <header className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 className="text-3xl font-bold tracking-tight text-slate-900">행사 및 일정 관리</h1>
          <p className="text-slate-500 mt-1">동아리의 일정을 관리하고 출석 QR 코드를 생성하세요.</p>
        </div>
        <button 
          onClick={() => setIsAdding(true)}
          className="flex items-center justify-center gap-2 px-6 py-3 bg-indigo-600 text-white rounded-2xl font-bold hover:bg-indigo-700 transition-all active:scale-95 shadow-lg shadow-indigo-100"
        >
          <Plus size={20} />
          새 일정 등록
        </button>
      </header>

      {/* Calendar Section */}
      <section className="bg-white p-6 md:p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
        <div className="flex items-center justify-between mb-8">
          <h2 className="text-2xl font-black text-slate-900 flex items-center gap-2">
            {year}년 {monthNames[month]}
          </h2>
          <div className="flex items-center gap-2">
            <button onClick={handlePrevMonth} className="p-2 hover:bg-slate-100 rounded-xl transition-colors text-slate-400 hover:text-indigo-600">
              <ChevronLeft size={24} />
            </button>
            <button onClick={handleNextMonth} className="p-2 hover:bg-slate-100 rounded-xl transition-colors text-slate-400 hover:text-indigo-600">
              <ChevronRight size={24} />
            </button>
          </div>
        </div>

        <div className="grid grid-cols-7 gap-2 md:gap-4 mb-4">
          {weekDays.map(day => (
            <div key={day} className="text-center text-sm font-bold text-slate-400 pb-2">
              {day}
            </div>
          ))}
          
          {Array.from({ length: firstDay }).map((_, i) => (
            <div key={`empty-${i}`} className="h-12 md:h-16" />
          ))}
          
          {Array.from({ length: daysInMonth }).map((_, i) => {
            const day = i + 1;
            const dateStr = formatDateString(year, month, day);
            const daySchedules = schedules.filter(s => s.date === dateStr);
            const isToday = formatDateString(new Date().getFullYear(), new Date().getMonth(), new Date().getDate()) === dateStr;
            const hasEvent = daySchedules.length > 0;

            return (
              <div 
                key={day} 
                className={`relative h-12 md:h-16 rounded-2xl border flex items-center justify-center transition-all ${
                  hasEvent ? 'border-indigo-200 bg-indigo-50 hover:bg-indigo-100 cursor-pointer' : 'border-slate-50 bg-white hover:border-slate-200'
                } ${isToday && !hasEvent ? 'border-indigo-600 border-2' : ''}`}
              >
                <span className={`text-sm md:text-base font-bold ${
                  hasEvent ? 'text-indigo-900' : isToday ? 'text-indigo-600' : 'text-slate-600'
                }`}>
                  {day}
                </span>
                
                {hasEvent && (
                  <div className="absolute bottom-2 md:bottom-3 flex gap-1">
                    {daySchedules.map((s, idx) => (
                      <div key={idx} className={`w-1.5 h-1.5 rounded-full ${s.type === 'ASSIGNMENT' ? 'bg-amber-500' : 'bg-indigo-500'}`} />
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>

      {/* Schedule List Section */}
      <section className="space-y-4">
        <h2 className="text-xl font-bold text-slate-900 flex items-center gap-2 mb-6">
          <CalendarIcon size={22} className="text-indigo-600" />
          등록된 일정 목록
        </h2>
        
        {isLoading ? (
          <div className="animate-pulse space-y-4">
            {[1, 2, 3].map(i => (
              <div key={i} className="h-32 bg-slate-100 rounded-3xl" />
            ))}
          </div>
        ) : schedules.length === 0 ? (
          <div className="bg-white rounded-3xl p-12 text-center border border-slate-100 shadow-sm flex flex-col items-center">
            <div className="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-4 text-slate-300">
              <CalendarIcon size={32} />
            </div>
            <h3 className="text-lg font-bold text-slate-900 mb-1">등록된 일정이 없습니다</h3>
            <p className="text-slate-500 text-sm">우측 상단의 버튼을 눌러 새 일정을 추가해보세요.</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {schedules.map(schedule => {
              const isAssignment = schedule.type === 'ASSIGNMENT';
              return (
                <div key={schedule.id} className={`bg-white rounded-[2rem] p-6 border ${schedule.is_approved === false ? 'border-amber-200 bg-amber-50/30' : 'border-slate-100'} shadow-sm hover:shadow-md transition-shadow flex flex-col group relative overflow-hidden`}>
                  <div className={`absolute top-0 left-0 w-full h-1.5 ${isAssignment ? 'bg-amber-400' : 'bg-indigo-600'}`} />
                  
                  <div className="flex justify-between items-start mb-4">
                    <div className="flex gap-2 items-center">
                      <span className={`px-2.5 py-1 rounded-md text-[10px] font-black uppercase tracking-wider ${
                        isAssignment ? 'bg-amber-100 text-amber-700' : 'bg-indigo-100 text-indigo-700'
                      }`}>
                        {isAssignment ? '과제 포함 세션' : '일반 세션'}
                      </span>
                      {schedule.is_approved === false && (
                        <span className="px-2.5 py-1 rounded-md text-[10px] font-black uppercase tracking-wider bg-red-100 text-red-700 animate-pulse">
                          승인 대기 중
                        </span>
                      )}
                    </div>
                    <button 
                      onClick={() => handleDelete(schedule.id)}
                      className="text-slate-300 hover:text-red-500 transition-colors p-1"
                    >
                      <Trash2 size={16} />
                    </button>
                  </div>
                  
                  <h3 className="text-lg font-bold text-slate-900 mb-3 line-clamp-2">{schedule.title}</h3>
                  
                  <div className="space-y-2 mb-6 flex-1">
                    <div className="flex items-center gap-2 text-sm text-slate-600 font-medium">
                      <CalendarIcon size={16} className="text-slate-400" />
                      {schedule.date}
                    </div>
                    <div className="flex items-center gap-2 text-sm text-slate-600 font-medium">
                      <Clock size={16} className="text-slate-400" />
                      {schedule.time.substring(0, 5)}
                    </div>
                    {schedule.location && (
                      <div className="flex items-center gap-2 text-sm text-slate-600 font-medium">
                        <MapPin size={16} className="text-slate-400" />
                        <span className="line-clamp-1">{schedule.location}</span>
                      </div>
                    )}
                    {isAssignment && schedule.assignment_template_url && (
                      <div className="flex items-center gap-2 text-sm text-amber-600 font-bold mt-2 bg-amber-50 p-2 rounded-xl border border-amber-100/50">
                        <FileIcon size={16} />
                        <a href={schedule.assignment_template_url} target="_blank" rel="noreferrer" className="hover:underline line-clamp-1">양식 첨부됨</a>
                      </div>
                    )}
                  </div>
                  
                  <button 
                    onClick={() => setSelectedQR(schedule.id)}
                    className="w-full flex items-center justify-center gap-2 py-3 bg-slate-900 text-white rounded-xl font-bold hover:bg-indigo-600 transition-colors"
                  >
                    <QrCode size={18} />
                    QR 생성
                  </button>
                </div>
              );
            })}
          </div>
        )}
      </section>

      {/* Add Schedule Modal */}
      <AnimatePresence>
        {isAdding && (
          <div className="fixed inset-0 z-[100] flex items-center justify-center p-4">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setIsAdding(false)}
              className="absolute inset-0 bg-black/40 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.95, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.95, y: 20 }}
              className="relative bg-white w-full max-w-lg rounded-[2.5rem] shadow-2xl overflow-hidden flex flex-col max-h-[90vh]"
            >
              <div className="shrink-0 p-8 border-b border-slate-100 flex items-center justify-between">
                <h3 className="text-2xl font-bold text-slate-900">새 일정 등록</h3>
                <button onClick={() => setIsAdding(false)} className="p-2 hover:bg-slate-100 rounded-xl transition-colors">
                  <X size={24} className="text-slate-500" />
                </button>
              </div>

              <form onSubmit={handleAddSchedule} className="p-8 space-y-6 overflow-y-auto">
                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">일정 분류</label>
                  <div className="grid grid-cols-2 gap-3">
                    <button
                      type="button"
                      onClick={() => setNewSchedule({...newSchedule, type: 'GENERAL'})}
                      className={`p-3 rounded-2xl border-2 font-bold text-sm flex items-center justify-center gap-2 transition-all ${
                        newSchedule.type === 'GENERAL' ? 'border-indigo-600 text-indigo-700 bg-indigo-50' : 'border-slate-100 text-slate-400 hover:border-slate-200'
                      }`}
                    >
                      <CalendarIcon size={18} /> 일반 일정
                    </button>
                    <button
                      type="button"
                      onClick={() => setNewSchedule({...newSchedule, type: 'ASSIGNMENT'})}
                      className={`p-3 rounded-2xl border-2 font-bold text-sm flex items-center justify-center gap-2 transition-all ${
                        newSchedule.type === 'ASSIGNMENT' ? 'border-amber-500 text-amber-600 bg-amber-50' : 'border-slate-100 text-slate-400 hover:border-slate-200'
                      }`}
                    >
                      <BookOpen size={18} /> 과제 포함
                    </button>
                  </div>
                </div>

                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">일정 제목</label>
                  <input 
                    required
                    type="text"
                    value={newSchedule.title}
                    onChange={e => setNewSchedule({...newSchedule, title: e.target.value})}
                    placeholder="예: 정기 세션 4주차"
                    className="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none"
                  />
                </div>

                <div className="grid grid-cols-2 gap-4">
                  <div className="space-y-2">
                    <label className="text-sm font-bold text-slate-700">날짜</label>
                    <input 
                      required
                      type="date"
                      value={newSchedule.date}
                      onChange={e => setNewSchedule({...newSchedule, date: e.target.value})}
                      className="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none"
                    />
                  </div>
                  <div className="space-y-2">
                    <label className="text-sm font-bold text-slate-700">시간</label>
                    <input 
                      required
                      type="time"
                      value={newSchedule.time}
                      onChange={e => setNewSchedule({...newSchedule, time: e.target.value})}
                      className="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none"
                    />
                  </div>
                </div>

                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">장소 (선택)</label>
                  <input 
                    type="text"
                    value={newSchedule.location}
                    onChange={e => setNewSchedule({...newSchedule, location: e.target.value})}
                    placeholder="예: 공학관 302호"
                    className="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none"
                  />
                </div>

                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">설명 (선택)</label>
                  <textarea 
                    value={newSchedule.description}
                    onChange={e => setNewSchedule({...newSchedule, description: e.target.value})}
                    placeholder="일정에 대한 상세 내용을 입력하세요..."
                    className="w-full h-24 p-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none resize-none"
                  />
                </div>

                <AnimatePresence>
                  {newSchedule.type === 'ASSIGNMENT' && (
                    <motion.div 
                      initial={{ opacity: 0, height: 0 }}
                      animate={{ opacity: 1, height: 'auto' }}
                      exit={{ opacity: 0, height: 0 }}
                      className="space-y-2 overflow-hidden"
                    >
                      <label className="text-sm font-bold text-slate-700 flex items-center justify-between">
                        과제 양식 파일 업로드 (선택)
                        {file && (
                          <button 
                            type="button" 
                            onClick={(e) => { e.preventDefault(); setFile(null); }}
                            className="text-xs text-red-500 hover:text-red-700 p-1"
                          >
                            삭제
                          </button>
                        )}
                      </label>
                      <div 
                        onDragOver={(e) => { e.preventDefault(); setIsDragOver(true); }}
                        onDragLeave={(e) => { e.preventDefault(); setIsDragOver(false); }}
                        onDrop={(e) => {
                          e.preventDefault();
                          setIsDragOver(false);
                          if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                            setFile(e.dataTransfer.files[0]);
                          }
                        }}
                        className={`w-full p-6 text-center rounded-2xl border-2 border-dashed transition-all relative ${
                          isDragOver ? 'border-amber-500 bg-amber-50' : 'border-slate-200 bg-slate-50 hover:bg-slate-100'
                        }`}
                      >
                        <input 
                          type="file" 
                          id="file-upload" 
                          className="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                          onChange={(e) => {
                            if (e.target.files && e.target.files[0]) {
                              setFile(e.target.files[0]);
                            }
                          }}
                        />
                        <div className="flex flex-col items-center justify-center pointer-events-none">
                          {file ? (
                            <>
                              <div className="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mb-3">
                                <FileIcon size={24} />
                              </div>
                              <p className="font-bold text-slate-800 text-sm">{file.name}</p>
                              <p className="text-xs text-slate-400 mt-1">{(file.size / 1024 / 1024).toFixed(2)} MB</p>
                            </>
                          ) : (
                            <>
                              <div className="w-12 h-12 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mb-3">
                                <UploadCloud size={24} />
                              </div>
                              <p className="font-bold text-slate-800 text-sm">클릭하거나 파일을 드래그하여 업로드</p>
                              <p className="text-xs text-slate-400 mt-1">PDF, Word, HWP 등 과제 제출 양식 파일</p>
                            </>
                          )}
                        </div>
                      </div>
                    </motion.div>
                  )}
                </AnimatePresence>

                <button 
                  type="submit"
                  disabled={isUploading}
                  className="w-full py-4 bg-indigo-600 text-white rounded-2xl font-bold hover:bg-indigo-700 active:scale-[0.98] transition-all shadow-lg shadow-indigo-100 disabled:opacity-70 flex items-center justify-center gap-2"
                >
                  {isUploading ? (
                    <>
                      <Loader2 className="animate-spin" size={20} />
                      업로드 및 등록 중...
                    </>
                  ) : (
                    '일정 등록하기'
                  )}
                </button>
              </form>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* QR Modal rendered contextually */}
      {selectedQR && (
        <AttendanceQR 
          scheduleId={selectedQR} 
          onClose={() => setSelectedQR(null)} 
        />
      )}
    </div>
  );
}
</file>

<file path="src/pages/admin/Settings.tsx">
import React, { useState, useEffect } from 'react';
import { supabase } from '../../lib/supabase';
import { useAuth } from '../../context/AuthContext';
import { Club, Project } from '../../types';
import { Settings as SettingsIcon, Image as ImageIcon, Link as LinkIcon, Save, Plus, Loader2, Megaphone, Info, CheckCircle2, X, Trash2 } from 'lucide-react';
import { motion, AnimatePresence } from 'motion/react';
import { clsx, type ClassValue } from 'clsx';
import { twMerge } from 'tailwind-merge';

function cn(...inputs: ClassValue[]) {
  return twMerge(clsx(inputs));
}

type TabType = 'BASIC' | 'RECRUIT' | 'PROJECTS';

export function Settings() {
  const { profile } = useAuth();
  const [activeTab, setActiveTab] = useState<TabType>('BASIC');
  
  const [club, setClub] = useState<Club | null>(null);
  const [projects, setProjects] = useState<Project[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [isSaving, setIsSaving] = useState(false);
  
  const [toast, setToast] = useState<string | null>(null);

  // Forms
  const [basicForm, setBasicForm] = useState({ name: '', category: '', description: '' });
  const [recruitForm, setRecruitForm] = useState({ is_recruiting: false, recruit_description: '', recruit_link: '' });

  // Project Modal
  const [isAddingProject, setIsAddingProject] = useState(false);
  const [newProject, setNewProject] = useState({ title: '', description: '', image_url: '', link: '' });
  const [isSubmittingProject, setIsSubmittingProject] = useState(false);

  useEffect(() => {
    // profile 로딩이 완료된 후에만 실행
    if (profile === undefined) return;
    fetchClubData();
  }, [profile]);

  const showToast = (msg: string) => {
    setToast(msg);
    setTimeout(() => setToast(null), 3000);
  };

  const setDummyData = () => {
    const dummyClub = {
      id: 'dummy-club',
      name: '로보트 동아리',
      category: 'IT/기술',
      description: '로봇 연구 및 제작 동아리입니다.',
      is_recruiting: true,
      recruit_description: '열정적인 코더 분들을 모십니다!',
      recruit_link: 'https://forms.google.com/test',
      admin_id: profile?.id || 'admin',
      created_at: new Date().toISOString()
    };
    setClub(dummyClub);
    setBasicForm({
      name: dummyClub.name,
      category: dummyClub.category,
      description: dummyClub.description
    });
    setRecruitForm({
      is_recruiting: dummyClub.is_recruiting,
      recruit_description: dummyClub.recruit_description,
      recruit_link: dummyClub.recruit_link
    });
    setProjects([
      {
        id: 'p1',
        club_id: 'dummy-club',
        title: '로봇 청소기 프로젝트',
        description: '자율주행 쓰레기 수거 로봇 제작',
        image_url: 'https://images.unsplash.com/photo-1485083269755-a7b559a4fe5e?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80',
        link: 'https://github.com/robotics',
        created_at: new Date().toISOString()
      }
    ]);
  };

  const fetchClubData = async () => {
    try {
      setIsLoading(true);
      // Fetch Club by admin_id
      const { data: clubData, error: clubError } = await supabase
        .from('clubs')
        .select('*')
        .eq('admin_id', profile?.id)
        .single();
        
      if (clubError) throw clubError;
      
      setClub(clubData);
      setBasicForm({
        name: clubData.name || '',
        category: clubData.category || '',
        description: clubData.description || ''
      });
      setRecruitForm({
        is_recruiting: !!clubData.is_recruiting,
        recruit_description: clubData.recruit_description || '',
        recruit_link: clubData.recruit_link || ''
      });

      // Fetch Projects
      const { data: projectData, error: projectError } = await supabase
        .from('projects')
        .select('*')
        .eq('club_id', clubData.id)
        .order('created_at', { ascending: false });

      if (projectError && projectError.code !== '42P01') { 
        console.error(projectError);
      }
      if (projectData) {
        setProjects(projectData);
      }
    } catch (error) {
      console.error('Error fetching club info:', error);
      // DB 에러 시 무한 로딩 방지 및 더미 데이터 주입
      setDummyData();
    } finally {
      setIsLoading(false);
    }
  };

  const handleSaveBasic = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!profile?.id) return;
    try {
      setIsSaving(true);
      const { data, error } = await supabase
        .from('clubs')
        .update({
          name: basicForm.name,
          category: basicForm.category,
          description: basicForm.description
        })
        .eq('admin_id', profile.id)
        .select();

      if (error) throw error;
      
      if (data && data.length === 0) {
        console.warn("[SaveBasic] 업데이트된 행이 없습니다. clubs 테이블에 admin_id가 일치하는 데이터가 있는지 확인하세요. 현재 profile.id:", profile.id);
      }

      showToast('성공적으로 저장되었습니다!');
      alert('성공적으로 저장되었습니다!');
    } catch (error: any) {
      console.error('[DB Error] 기본 정보 저장 실패:', error);
      alert('저장 실패: ' + error.message);
    } finally {
      setIsSaving(false);
    }
  };

  const handleSaveRecruit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!profile?.id) return;
    try {
      setIsSaving(true);
      const { data, error } = await supabase
        .from('clubs')
        .update({
          is_recruiting: recruitForm.is_recruiting,
          recruit_description: recruitForm.recruit_description,
          recruit_link: recruitForm.recruit_link
        })
        .eq('admin_id', profile.id)
        .select();

      if (error) throw error;
      
      if (data && data.length === 0) {
        console.warn("[SaveRecruit] 업데이트된 행이 없습니다. clubs 테이블에 admin_id가 일치하는 데이터가 있는지 확인하세요. 현재 profile.id:", profile.id);
      }

      showToast('성공적으로 저장되었습니다!');
      alert('성공적으로 저장되었습니다!');
    } catch (error: any) {
      console.error('[DB Error] 부원 모집 설정 저장 실패:', error);
      alert('저장 실패: ' + error.message);
    } finally {
      setIsSaving(false);
    }
  };

  const handleAddProject = async (e: React.FormEvent) => {
    e.preventDefault();
    // 'dummy-club' 이면 실제 DB 저장을 생략하거나, club 정보 여부를 다시 확인
    const targetClubId = club?.id === 'dummy-club' ? null : club?.id;
    
    if (!profile?.id) return;
    try {
      setIsSubmittingProject(true);
      
      if (!targetClubId) {
        throw new Error('실제 동아리가 개설되지 않은 테스트 상태에서는 프로젝트를 DB에 저장할 수 없습니다. 동아리를 먼저 개설해주세요.');
      }
      
      const { data, error } = await supabase
        .from('projects')
        .insert([{
          club_id: targetClubId,
          title: newProject.title,
          description: newProject.description,
          image_url: newProject.image_url,
          link: newProject.link
        }])
        .select()
        .single();

      if (error) {
         if (error.code === '42P01') {
           throw new Error('데이터베이스에 projects 테이블이 아직 생성되지 않았습니다.');
         }
         throw error;
      }
      
      setProjects([data, ...projects]);
      setIsAddingProject(false);
      setNewProject({ title: '', description: '', image_url: '', link: '' });
      showToast('성공적으로 저장되었습니다!');
      alert('프로젝트가 추가되었습니다!');
    } catch (error: any) {
      console.error('[DB Error] 프로젝트 추가 실패:', error);
      alert('프로젝트 추가 실패: ' + error.message);
    } finally {
      setIsSubmittingProject(false);
    }
  };

  const handleDeleteProject = async (id: string) => {
    if (!window.confirm('프로젝트를 삭제하시겠습니까?')) return;
    try {
      const { error } = await supabase.from('projects').delete().eq('id', id);
      if (error) throw error;
      setProjects(projects.filter(p => p.id !== id));
    } catch (err) {
      console.error(err);
    }
  };

  if (isLoading) {
    return (
      <div className="flex-1 flex items-center justify-center p-12">
        <Loader2 className="w-8 h-8 text-indigo-600 animate-spin" />
      </div>
    );
  }

  return (
    <div className="flex-1 max-w-5xl mx-auto space-y-8 pb-12">
      <header className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 className="text-3xl font-bold tracking-tight text-slate-900 flex items-center gap-3">
            <SettingsIcon className="text-indigo-600" size={32} />
            동아리 설정
          </h1>
          <p className="text-slate-500 mt-1">기본 정보부터 부원 모집, 프로젝트까지 동아리의 핵심 데이터를 관리하세요.</p>
        </div>
      </header>

      {/* Tabs Navigation */}
      <div className="bg-slate-100/70 p-1.5 rounded-2xl flex md:inline-flex w-full md:w-auto">
        {[
          { id: 'BASIC', label: '기본 정보', icon: Info },
          { id: 'RECRUIT', label: '부원 모집', icon: Megaphone },
          { id: 'PROJECTS', label: '프로젝트 홍보', icon: ImageIcon },
        ].map((tab) => (
          <button
            key={tab.id}
            onClick={() => setActiveTab(tab.id as TabType)}
            className={`flex-1 md:flex-none flex items-center justify-center gap-2 px-5 py-3 md:px-6 md:py-2.5 rounded-xl text-sm font-bold transition-all relative ${
              activeTab === tab.id 
                ? 'text-indigo-700 bg-white shadow-sm ring-1 ring-slate-900/5' 
                : 'text-slate-500 hover:text-slate-700 hover:bg-slate-200/50'
            }`}
          >
            <tab.icon size={16} />
            {tab.label}
          </button>
        ))}
      </div>

      {/* Tabs Content */}
      <div className="bg-white rounded-[2rem] border border-slate-100 shadow-sm overflow-hidden">
        
        {/* BASIC INFO TAB */}
        {activeTab === 'BASIC' && (
          <div className="p-6 md:p-10 animate-in fade-in duration-500">
            <div className="mb-8">
              <h2 className="text-xl font-bold text-slate-900">기본 정보</h2>
              <p className="text-sm text-slate-500 mt-1">앱 전반에 노출되는 동아리의 핵심 아이덴티티입니다.</p>
            </div>
            <form onSubmit={handleSaveBasic} className="max-w-2xl space-y-6">
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">동아리 이름 <span className="text-red-500">*</span></label>
                <input 
                  required type="text" value={basicForm.name} onChange={e => setBasicForm({...basicForm, name: e.target.value})}
                  className="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none"
                />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">동아리 카테고리 (분야)</label>
                <input 
                  type="text" placeholder="예: IT / 개발 / 기획" value={basicForm.category} onChange={e => setBasicForm({...basicForm, category: e.target.value})}
                  className="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none"
                />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">한 줄 소개</label>
                <textarea 
                  value={basicForm.description} onChange={e => setBasicForm({...basicForm, description: e.target.value})}
                  placeholder="짧고 강렬하게 동아리를 소개해주세요."
                  className="w-full p-4 h-24 resize-none rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none"
                />
              </div>
              <button disabled={isSaving} className="px-8 py-4 bg-indigo-600 text-white rounded-2xl font-bold hover:bg-indigo-700 active:scale-95 transition-all shadow-lg shadow-indigo-100 flex items-center justify-center gap-2">
                {isSaving ? <Loader2 className="animate-spin w-5 h-5" /> : <Save className="w-5 h-5" />}
                변경사항 저장
              </button>
            </form>
          </div>
        )}

        {/* RECRUIT TAB */}
        {activeTab === 'RECRUIT' && (
          <div className="p-6 md:p-10 animate-in fade-in duration-500">
            <div className="mb-8">
              <h2 className="text-xl font-bold text-slate-900">신입 부원 모집 설정</h2>
              <p className="text-sm text-slate-500 mt-1">모집 공고를 켜시면 대시보드 및 랜딩 페이지에 노출됩니다.</p>
            </div>
            <form onSubmit={handleSaveRecruit} className="max-w-2xl space-y-8">
              
              <div className="flex items-center justify-between p-5 md:p-6 bg-slate-50 rounded-2xl border border-slate-100">
                <div>
                  <h4 className="font-bold text-slate-900">현재 신입 부원 모집 중</h4>
                  <p className="text-sm text-slate-500 mt-0.5">토글을 활성화하여 모집을 시작하세요.</p>
                </div>
                <button
                  type="button"
                  onClick={() => setRecruitForm(p => ({ ...p, is_recruiting: !p.is_recruiting }))}
                  className={`relative inline-flex h-8 w-14 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 outline-none flex items-center shadow-inner ${
                    recruitForm.is_recruiting ? "bg-indigo-600" : "bg-slate-300"
                  }`}
                >
                  <span className={`pointer-events-none inline-block h-7 w-7 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out ${
                    recruitForm.is_recruiting ? "translate-x-6" : "translate-x-0"
                  }`} />
                </button>
              </div>

              <div className={`space-y-6 transition-opacity duration-300 ${!recruitForm.is_recruiting ? 'opacity-40 pointer-events-none' : 'opacity-100'}`}>
                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">지원 폼 (링크)</label>
                  <div className="relative">
                    <div className="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                      <LinkIcon className="text-slate-400" size={20} />
                    </div>
                    <input 
                      type="url" placeholder="https://forms.google.com/..." 
                      value={recruitForm.recruit_link} onChange={e => setRecruitForm({...recruitForm, recruit_link: e.target.value})}
                      className="w-full pl-12 pr-4 py-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none"
                    />
                  </div>
                </div>
                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">모집 공고 본문 내용</label>
                  <textarea 
                    value={recruitForm.recruit_description} onChange={e => setRecruitForm({...recruitForm, recruit_description: e.target.value})}
                    placeholder="모집 조건, 기간, 활동 내용 등을 자유롭게 적어주세요."
                    className="w-full p-4 h-48 resize-none rounded-2xl bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition-all outline-none leading-relaxed"
                  />
                </div>
              </div>

              <button disabled={isSaving} className="px-8 py-4 bg-indigo-600 text-white rounded-2xl font-bold hover:bg-indigo-700 active:scale-95 transition-all shadow-lg shadow-indigo-100 flex items-center justify-center gap-2">
                {isSaving ? <Loader2 className="animate-spin w-5 h-5" /> : <Save className="w-5 h-5" />}
                모집 설정 저장
              </button>
            </form>
          </div>
        )}

        {/* PROJECTS TAB */}
        {activeTab === 'PROJECTS' && (
          <div className="p-6 md:p-10 animate-in fade-in duration-500 bg-slate-50/30">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
              <div>
                <h2 className="text-xl font-bold text-slate-900">진행한 프로젝트</h2>
                <p className="text-sm text-slate-500 mt-1">우리 동아리의 멋진 포트폴리오를 아카이빙하세요.</p>
              </div>
              <button 
                onClick={() => setIsAddingProject(true)}
                className="flex items-center justify-center gap-2 px-5 py-3 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 transition-all active:scale-95 shadow-md flex-shrink-0"
              >
                <Plus size={18} />
                프로젝트 추가
              </button>
            </div>

            {projects.length === 0 ? (
              <div className="bg-slate-50 rounded-3xl p-12 text-center border border-dashed border-slate-200">
                <div className="w-16 h-16 bg-white shadow-sm rounded-2xl flex items-center justify-center mx-auto mb-4 text-slate-300">
                  <ImageIcon size={32} />
                </div>
                <h3 className="text-lg font-bold text-slate-900 mb-1">등록된 프로젝트가 없습니다</h3>
                <p className="text-slate-500 text-sm">상단의 버튼을 눌러 첫 번째 프로젝트를 추가해보세요.</p>
              </div>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                {projects.map((proj) => (
                  <div key={proj.id} className="bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-sm group hover:shadow-md transition-shadow relative">
                    <button 
                      onClick={() => handleDeleteProject(proj.id)}
                      className="absolute top-4 right-4 p-2 bg-white/90 backdrop-blur text-red-500 hover:text-red-700 rounded-lg shadow-sm z-10 opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                      <Trash2 size={16} />
                    </button>
                    {proj.image_url ? (
                      <div className="w-full h-48 bg-slate-100 overflow-hidden">
                        <img src={proj.image_url} alt={proj.title} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      </div>
                    ) : (
                      <div className="w-full h-48 bg-slate-100 flex flex-col items-center justify-center text-slate-300 gap-2">
                        <ImageIcon size={32} />
                        <span className="text-sm font-medium">No Image</span>
                      </div>
                    )}
                    <div className="p-6 space-y-3">
                      <h4 className="text-lg font-bold text-slate-900">{proj.title}</h4>
                      <p className="text-sm text-slate-500 line-clamp-2">{proj.description}</p>
                      {proj.link && (
                        <a href={proj.link} target="_blank" rel="noreferrer" className="inline-flex items-center gap-1.5 text-sm font-bold text-indigo-600 hover:text-indigo-800">
                          <LinkIcon size={14} /> 링크 열기
                        </a>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}
      </div>

      {/* Project Creation Modal */}
      <AnimatePresence>
        {isAddingProject && (
          <div className="fixed inset-0 z-[100] flex items-center justify-center p-4">
            <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} onClick={() => setIsAddingProject(false)} className="absolute inset-0 bg-black/40 backdrop-blur-sm" />
            <motion.div initial={{ opacity: 0, scale: 0.95, y: 20 }} animate={{ opacity: 1, scale: 1, y: 0 }} exit={{ opacity: 0, scale: 0.95, y: 20 }}
              className="relative bg-white w-full max-w-md rounded-[2.5rem] shadow-2xl overflow-hidden flex flex-col max-h-[90vh]"
            >
              <div className="shrink-0 p-8 border-b border-slate-100 flex items-center justify-between">
                <h3 className="text-2xl font-bold text-slate-900">프로젝트 등록</h3>
                <button onClick={() => setIsAddingProject(false)} className="p-2 hover:bg-slate-100 rounded-xl transition-colors"><X size={24} className="text-slate-500" /></button>
              </div>
              <form onSubmit={handleAddProject} className="p-8 space-y-6 overflow-y-auto">
                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">프로젝트 제목 <span className="text-red-500">*</span></label>
                  <input 
                    required type="text" value={newProject.title} onChange={e => setNewProject({...newProject, title: e.target.value})}
                    className="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 outline-none focus:border-indigo-500"
                  />
                </div>
                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">설명</label>
                  <textarea 
                    value={newProject.description} onChange={e => setNewProject({...newProject, description: e.target.value})}
                    className="w-full p-4 h-24 resize-none rounded-2xl bg-slate-50 border border-slate-200 outline-none focus:border-indigo-500"
                  />
                </div>
                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">이미지 URL (임시)</label>
                  <input 
                    type="url" placeholder="https://..." value={newProject.image_url} onChange={e => setNewProject({...newProject, image_url: e.target.value})}
                    className="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 outline-none focus:border-indigo-500"
                  />
                  <p className="text-[10px] text-slate-400">MVP 단계에서는 이미지 링크를 직접 입력합니다.</p>
                </div>
                <div className="space-y-2">
                  <label className="text-sm font-bold text-slate-700">바로가기 링크</label>
                  <input 
                    type="url" placeholder="https://..." value={newProject.link} onChange={e => setNewProject({...newProject, link: e.target.value})}
                    className="w-full p-4 rounded-2xl bg-slate-50 border border-slate-200 outline-none focus:border-indigo-500"
                  />
                </div>
                <button type="submit" disabled={isSubmittingProject} className="w-full py-4 mt-2 bg-indigo-600 text-white rounded-2xl font-bold hover:bg-indigo-700 active:scale-95 transition-all disabled:opacity-70 flex items-center justify-center gap-2">
                  {isSubmittingProject ? <Loader2 className="animate-spin" size={20} /> : '등록하기'}
                </button>
              </form>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Toast Notification */}
      <AnimatePresence>
        {toast && (
          <motion.div initial={{ opacity: 0, y: 50, scale: 0.9 }} animate={{ opacity: 1, y: 0, scale: 1 }} exit={{ opacity: 0, y: 20, scale: 0.9 }}
            className="fixed bottom-8 right-8 z-[200] flex items-center gap-3 px-6 py-4 bg-slate-900 text-white rounded-2xl shadow-2xl font-bold"
          >
            <CheckCircle2 className="text-emerald-400" size={24} />
            {toast}
          </motion.div>
        )}
      </AnimatePresence>
      
    </div>
  );
}
</file>

