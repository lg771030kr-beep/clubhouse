        </div>
      </div>

      {isScannerOpen && <QRScanner onScanSuccess={handleScanSuccess} onClose={() => setIsScannerOpen(false)} />}

      <AnimatePresence>
        {isAddingSchedule && (
          <div className="fixed inset-0 z-[100] flex items-center justify-center p-4">
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0 }}
              onClick={() => setIsAddingSchedule(false)}
              className="absolute inset-0 bg-black/40 backdrop-blur-sm"
            />
            <motion.div
              initial={{ opacity: 0, scale: 0.95, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.95, y: 20 }}
              className="relative flex max-h-[90vh] w-full max-w-sm flex-col overflow-hidden rounded-[2rem] bg-white shadow-2xl"
            >
              <div className="flex shrink-0 items-center justify-between border-b border-slate-100 p-6">
                <h3 className="text-xl font-bold text-slate-900">팀 일정 제안</h3>
                <button type="button" onClick={() => setIsAddingSchedule(false)} className="rounded-xl p-2 hover:bg-slate-100">
                  <X size={24} className="text-slate-500" />
                </button>
              </div>

              <form onSubmit={handleCreateTeamSchedule} className="space-y-5 overflow-y-auto p-6">
                <div className="space-y-1.5">
                  <label className="text-sm font-bold text-slate-700">일정명</label>
                  <input
                    required
                    type="text"
                    value={newSchedule.title}
                    onChange={(e) => setNewSchedule({ ...newSchedule, title: e.target.value })}
                    placeholder="팀 온라인 미팅"
                    className="w-full rounded-xl border border-slate-200 bg-slate-50 p-4 outline-none focus:border-blue-500"
                  />
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div className="space-y-1.5">
                    <label className="text-sm font-bold text-slate-700">날짜</label>
                    <input
                      required
                      type="date"
                      value={newSchedule.date}
                      onChange={(e) => setNewSchedule({ ...newSchedule, date: e.target.value })}
                      className="w-full rounded-xl border border-slate-200 bg-slate-50 p-4 outline-none focus:border-blue-500"
                    />
                  </div>
                  <div className="space-y-1.5">
                    <label className="text-sm font-bold text-slate-700">시간</label>
                    <input
                      required
                      type="time"
                      value={newSchedule.time}
                      onChange={(e) => setNewSchedule({ ...newSchedule, time: e.target.value })}
                      className="w-full rounded-xl border border-slate-200 bg-slate-50 p-4 outline-none focus:border-blue-500"
                    />
                  </div>
                </div>
                <div className="space-y-1.5">
                  <label className="text-sm font-bold text-slate-700">설명</label>
                  <textarea
                    value={newSchedule.description}
                    onChange={(e) => setNewSchedule({ ...newSchedule, description: e.target.value })}
                    placeholder="안건 및 준비물..."
                    className="h-24 w-full resize-none rounded-xl border border-slate-200 bg-slate-50 p-4 outline-none focus:border-blue-500"
                  />
                </div>

                <p className="flex gap-2 rounded-lg bg-amber-50 p-3 text-xs font-bold text-amber-800">
                  <Activity className="h-4 w-4 shrink-0" />
                  등록 시 운영진 승인 후 최종 반영됩니다.
                </p>

                <button
                  type="submit"
                  disabled={isSubmitting}
                  className="flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 py-4 font-bold text-white transition-all hover:bg-blue-700 active:scale-[0.98] disabled:opacity-70"
                >
                  {isSubmitting ? (
                    <>
                      <Loader2 className="h-5 w-5 animate-spin" /> 제출 중...
                    </>
                  ) : (
                    '승인 요청하기'
                  )}
                </button>
              </form>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {toastMessage && (
        <div className="fixed top-4 left-1/2 z-[110] -translate-x-1/2 animate-in fade-in slide-in-from-top-4 duration-300">
          <div
            className={`flex items-center gap-2 rounded-xl border px-4 py-3 shadow-xl ${
              toastMessage.type === 'success'
                ? 'border-emerald-200 bg-emerald-50 text-emerald-700'
                : 'border-red-200 bg-red-50 text-red-700'
            }`}
          >
            {toastMessage.type === 'success' ? <CheckCircle2 className="h-5 w-5" /> : <Activity className="h-5 w-5" />}
            <span className="text-sm font-bold tracking-tight">{toastMessage.title}</span>
          </div>
        </div>
      )}

      {selectedProject && (
        <div className="fixed inset-0 z-[110] flex items-end justify-center bg-black/50 p-0 sm:items-center sm:p-4">
          <Card className="w-full max-w-lg rounded-t-3xl border-slate-200 shadow-2xl sm:rounded-2xl">
            <CardHeader className="flex flex-row items-start justify-between space-y-0">
              <div className="pr-3">
                <CardTitle className="text-xl">{selectedProject.title}</CardTitle>
                <p className="mt-1 text-sm font-medium text-slate-500">{getProjectClubName(selectedProject)}</p>
              </div>
              <Button variant="ghost" size="sm" onClick={() => setSelectedProject(null)} aria-label="닫기">
                <X className="h-5 w-5" />
              </Button>
            </CardHeader>
            <CardContent className="space-y-4">
              <div className="h-44 w-full overflow-hidden rounded-xl bg-slate-100">
                {selectedProject.image_url ? (
                  <img src={selectedProject.image_url} alt={selectedProject.title} className="h-full w-full object-cover" />
                ) : (
                  <div className="flex h-full items-center justify-center text-sm font-bold text-slate-400">
                    썸네일이 없습니다.
                  </div>
                )}
              </div>
              <p className="whitespace-pre-wrap text-sm leading-6 text-slate-600">
                {selectedProject.description || '프로젝트 상세 설명이 아직 등록되지 않았습니다.'}
              </p>
              <div className="flex gap-2">
                <Button variant="outline" className="flex-1" onClick={() => setSelectedProject(null)}>
                  닫기
                </Button>
                <Button
                  className="flex-1"
                  onClick={() => {
                    window.open('/explore/projects', '_self');
                  }}
                >
                  협업 제안 <ExternalLink className="ml-1 h-4 w-4" />
                </Button>
              </div>
            </CardContent>
          </Card>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/pages/user/MyActivities.tsx">
import React, { useState } from 'react';
import { ChevronRight, ChevronDown, Activity, ArrowLeft, Calendar, FileText, Clock, Users, Zap, CheckCircle2 } from 'lucide-react';
import { useNavigate } from 'react-router-dom';
import { motion, AnimatePresence } from 'motion/react';

const DUMMY_ACTIVITIES = [
  { id: 1, club_name: '멋쟁이사자처럼', title: 'IT 서비스 개발 기획 회의', date: '2026. 03. 18', type: '출석', status: '완료' },
  { id: 2, club_name: '멋쟁이사자처럼', title: 'UI/UX 워크샵', date: '2026. 03. 16', type: '행사', status: '완료' },
  { id: 3, club_name: 'GDSC', title: '구글 솔루션 챌린지 킥오프', date: '2026. 03. 15', type: '출석', status: '완료' },
  { id: 4, club_name: '멋쟁이사자처럼', title: '1주차 과제 제출', date: '2026. 03. 14', type: '과제', status: '완료' },
  { id: 5, club_name: 'UMC', title: '안드로이드 스터디', date: '2026. 03. 10', type: '출석', status: '완료' },
  { id: 6, club_name: 'GDSC', title: '알고리즘 과제', date: '2026. 03. 08', type: '과제', status: '완료' },
  { id: 7, club_name: 'UMC', title: '1학기 OT', date: '2026. 03. 02', type: '행사', status: '완료' },
  { id: 8, club_name: '멋쟁이사자처럼', title: 'OT 및 신입생 환영회', date: '2026. 02. 25', type: '출석', status: '완료' }
];

const CLUB_CONFIG: Record<string, { color: string, bg: string, icon: any }> = {
  '멋쟁이사자처럼': { color: 'text-orange-600', bg: 'bg-orange-100', icon: Zap },
  'GDSC': { color: 'text-blue-600', bg: 'bg-blue-100', icon: Users },
  'UMC': { color: 'text-purple-600', bg: 'bg-purple-100', icon: Activity },
};

export function MyActivities() {
  const navigate = useNavigate();
  const [expandedClubs, setExpandedClubs] = useState<string[]>(['멋쟁이사자처럼']);

  const toggleClub = (clubName: string) => {
    setExpandedClubs(prev => 
      prev.includes(clubName) ? prev.filter(c => c !== clubName) : [...prev, clubName]
    );
  };

  // 1. Weekly Highlight (최근 7일)
  // 현실 날짜를 기준으로 과거 7일치를 계산 (YYYY. MM. DD 형식)
  const today = new Date('2026-03-19'); // User context "today" is approx Mar 19 2026
  const sevenDaysAgo = new Date(today);
  sevenDaysAgo.setDate(today.getDate() - 7);

  const weeklyActivities = DUMMY_ACTIVITIES.filter(a => {
    const activityDate = new Date(a.date.replace(/\. /g, '-'));
    return activityDate >= sevenDaysAgo && activityDate <= today;
  });

  // Grouping by Club
  const groupedObj = DUMMY_ACTIVITIES.reduce((acc, curr) => {
    if (!acc[curr.club_name]) acc[curr.club_name] = [];
    acc[curr.club_name].push(curr);
    return acc;
  }, {} as Record<string, typeof DUMMY_ACTIVITIES>);

  const clubs = Object.keys(groupedObj);

  return (
    <div className="min-h-screen bg-slate-50 font-sans pb-20 w-full mx-auto max-w-lg">
      <header className="bg-white px-6 py-4 flex items-center gap-4 border-b border-slate-100 sticky top-0 z-20">
        <button onClick={() => navigate(-1)} className="p-2 -ml-2 hover:bg-slate-100 rounded-full transition-colors active:scale-95">
          <ArrowLeft className="w-5 h-5 text-slate-600" />
        </button>
        <h1 className="text-lg font-bold text-slate-900">포트폴리오 기록</h1>
      </header>

      <div className="p-6 space-y-8">
        
        {/* Weekly Highlight */}
        <section className="animate-in fade-in slide-in-from-bottom-4 duration-500">
          <h2 className="text-lg font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span className="text-xl">🔥</span> 이번 주 하이라이트
          </h2>
          <div className="bg-gradient-to-br from-indigo-600 to-blue-600 rounded-3xl p-6 text-white shadow-lg shadow-indigo-500/30 relative overflow-hidden">
            <div className="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full blur-2xl -mr-10 -mt-10"></div>
            
            <p className="text-indigo-100 font-medium text-sm mb-1">최근 7일 간의 포트폴리오</p>
            <h3 className="text-2xl font-black mb-6">총 {weeklyActivities.length}건의 기록을 남겼어요!</h3>
            
            <div className="flex gap-4 relative z-10">
              <div className="flex-1 bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10">
                <div className="flex items-center gap-2 mb-2 text-indigo-100 text-sm font-bold">
                  <CheckCircle2 className="w-4 h-4" /> 출석
                </div>
                <p className="text-2xl font-bold">{weeklyActivities.filter(a => a.type === '출석').length}회</p>
              </div>
              <div className="flex-1 bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10">
                <div className="flex items-center gap-2 mb-2 text-indigo-100 text-sm font-bold">
                  <FileText className="w-4 h-4" /> 과제
                </div>
                <p className="text-2xl font-bold">{weeklyActivities.filter(a => a.type === '과제').length}회</p>
              </div>
            </div>
          </div>
        </section>

        {/* Grouped by Club */}
        <section className="animate-in fade-in slide-in-from-bottom-6 duration-700">
          <h2 className="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
            <Users className="w-5 h-5 text-slate-600" /> 소속 동아리별 기록
          </h2>
          
          <div className="space-y-4">
            {clubs.map(clubName => {
              const activities = groupedObj[clubName];
              const config = CLUB_CONFIG[clubName] || { color: 'text-slate-600', bg: 'bg-slate-100', icon: Activity };
              const ClubIcon = config.icon;
              const isExpanded = expandedClubs.includes(clubName);
              
              const attendanceCount = activities.filter(a => a.type === '출석').length;
              const taskCount = activities.filter(a => a.type === '과제').length;
              const eventCount = activities.filter(a => a.type === '행사').length;

              return (
                <div key={clubName} className="bg-white rounded-[1.5rem] border border-slate-200 overflow-hidden shadow-sm transition-all">
                  <button 
                    onClick={() => toggleClub(clubName)}
                    className="w-full p-5 flex items-center justify-between hover:bg-slate-50 transition-colors"
                  >
                    <div className="flex items-center gap-4">
                      <div className={`w-12 h-12 rounded-2xl flex items-center justify-center ${config.bg} ${config.color}`}>
                        <ClubIcon className="w-6 h-6" />
                      </div>
                      <div className="text-left">
                        <h3 className="font-bold text-slate-900 text-lg mb-0.5">{clubName}</h3>
                        <p className="text-xs text-slate-500 font-medium">
                          출석 {attendanceCount}회 · 과제 {taskCount}회 · 행사 {eventCount}회
                        </p>
                      </div>
                    </div>
                    <div className={`w-8 h-8 rounded-full flex items-center justify-center bg-slate-50 transition-transform duration-300 ${isExpanded ? 'rotate-180' : ''}`}>
                      <ChevronDown className="w-5 h-5 text-slate-400" />
                    </div>
                  </button>

                  <AnimatePresence initial={false}>
                    {isExpanded && (
                      <motion.div
                        initial={{ height: 0, opacity: 0 }}
                        animate={{ height: 'auto', opacity: 1 }}
                        exit={{ height: 0, opacity: 0 }}
                        className="border-t border-slate-100 bg-slate-50/50"
                      >
                        <div className="p-4 space-y-3">
                          {activities.map(activity => (
                            <div key={activity.id} className="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 flex items-center justify-between group">
                              <div className="flex flex-col gap-1.5">
                                <span className={`w-max text-[10px] font-black tracking-wider px-2 py-0.5 rounded shadow-sm border
                                  ${activity.type === '출석' ? 'bg-green-50 text-green-700 border-green-100' : 
                                    activity.type === '행사' ? 'bg-purple-50 text-purple-700 border-purple-100' : 'bg-blue-50 text-blue-700 border-blue-100'}`}>
                                  {activity.type} 완료
                                </span>
                                <p className="font-bold text-slate-800 text-sm">{activity.title}</p>
                                <div className="flex items-center gap-1.5 text-xs text-slate-400 font-medium mt-1">
                                  <Clock className="w-3.5 h-3.5" />
                                  {activity.date}
                                </div>
                              </div>
                              <div className="w-8 h-8 rounded-full flex items-center justify-center bg-slate-50 group-hover:bg-indigo-50 transition-colors cursor-pointer">
                                <ChevronRight className="w-4 h-4 text-slate-300 group-hover:text-indigo-500 flex-shrink-0" />
                              </div>
                            </div>
                          ))}
                        </div>
                      </motion.div>
                    )}
                  </AnimatePresence>
                </div>
              );
            })}
          </div>
        </section>

      </div>
    </div>
  );
}
