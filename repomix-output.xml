  const approveSchedule = async (id: string) => {
    try {
      const { error } = await supabase
        .from('schedules')
        .update({ is_approved: true })
        .eq('id', id);
      if (error) throw error;
      setPendingSchedules(prev => prev.filter(s => s.id !== id));
      // Toast would be nice here in a real app
