              </div>
              {selected.kind === 'ASSIGNMENT' && selected.assignment_template_url ? (
                <Button
                  type="button"
                  className="w-full"
                  onClick={() => window.open(selected.assignment_template_url!, '_blank', 'noopener,noreferrer')}
